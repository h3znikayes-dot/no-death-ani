{
  "schemaVersion": 1,
  "id": "deadwalking",
  "version": "${version}",
  "name": "Dead Walking",
  "description": "When a player dies, their body stays for 50 ticks, frozen in the exact pose they died in (mid-stride, sneaking, swimming, with their gear and skin).",
  "authors": [],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.deadwalking.DeadWalking"],
    "client": ["com.example.deadwalking.DeadWalkingClient"]
  },
  "mixins": [
    {
      "config": "deadwalking.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
