{
  "schemaVersion": 1,
  "id": "deadwalking",
  "version": "${version}",
  "name": "Dead Walking",
  "description": "When a player or mob dies, a copy of their body stays for 40 ticks, frozen in the exact pose they died in. Client-side only; works on any server.",
  "authors": [],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.deadwalking.DeadWalkingClient"]
  },
  "mixins": [
    {
      "config": "deadwalking.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
